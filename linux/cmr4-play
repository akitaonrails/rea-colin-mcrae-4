#!/bin/sh
# Plays Colin McRae Rally 04 on Linux through Wine and gamescope.
#
#   cmr4-play           show settings through Wine, then start the game
#   cmr4-play --play    start with saved settings (no window); "start" is an alias
#   cmr4-play stop      end the owned game session and its private Wine prefix
#                       (session group, then wineserver -k for that prefix only)
#   cmr4-play status    running or idle
#
# Optional environment:
#   CMR4_PREFIX    Wine prefix (default ~/.local/share/cmr4-launcher/prefix)
#   CMR4_LAUNCHER  CMR4Launcher.exe (default next to this script or one folder up)
#   CMR4_RUN       re-entrant wrapper for wine/gamescope commands
#   CMR4_WAIT      accepted for AppImage compatibility; every launch waits
#
# The session, GPU, gamescope and prefix handling is the shared play library
# (rea-play.sh from rea-launcher-sdk): next to this script in a package, else
# the vendored ../sdk copy.
set -u
_fonly=${REA_FUNCTIONS_ONLY:-}
_here=$(dirname "$(readlink -f "$0")")
[ "$_fonly" = 1 ] && [ -n "${REA_PLAY_HERE:-}" ] && _here=$REA_PLAY_HERE
if [ -f "$_here/rea-play.sh" ]; then
  . "$_here/rea-play.sh"
elif [ -f "$_here/../sdk/rea-play.sh" ]; then
  . "$_here/../sdk/rea-play.sh"
else
  echo "rea-play.sh not found next to $0 or in ../sdk (run scripts/sdk-sync)" >&2
  exit 1
fi
REA_HERE=$_here REA_NAME=cmr4-play

REA_APP=cmr4-launcher                 # ~/.config/cmr4-launcher, the prefix name
REA_EXE_NAME=CMR4Launcher.exe
REA_EXE_HINT=CMR4_LAUNCHER
REA_EXE=${CMR4_LAUNCHER:-}
REA_PREFIX=${CMR4_PREFIX:-}
REA_RUN=${CMR4_RUN:-}
REA_WAIT=${CMR4_WAIT:-}               # no effect: every launch waits
REA_CFG_APPDATA=CMR4Launcher          # AppData\Local\CMR4Launcher\launcher.cfg
REA_DEFAULT_SIZE=1024x768             # original, unset or invalid: the game's mode
REA_SCALER_KEY=                       # gamescope always scales with NIS
REA_DEFAULT_SCALER=nis
REA_LEGACY_LOCK=off                   # cmr4-play never wrote a pid-only lock
REA_HELPER_KEYS="look resolution"     # --look/--resolution size gamescope too

# The gamescope size a look gives (the launcher's Look::resolution in
# src/config.rs): Steam Deck 1280x800; Widescreen the screen, inside which
# the launcher then picks the largest exact 16:9, as it does on the real
# screen; Original the game's mode. Custom sets nothing.
cmr4_look_size() {
  case $1 in
    steam_deck) echo 1280x800 ;;
    widescreen) rea_screen_size || echo 1920x1080 ;;
    original) echo original ;;
    *) return 1 ;;
  esac
}

# A look fills the resolution its own source (launcher.cfg, or this run's
# flags) left unset, and flags win over the file, as in the launcher. The
# size goes into this run's values, which rea_game_size reads first.
rea_hook_before_start() {
  [ -n "$(REA_CFG=; rea_get_key resolution)" ] && return 0
  _cmr4_size=
  _cmr4_look=$(REA_CFG=; rea_get_value look)
  if [ -n "$_cmr4_look" ]; then
    _cmr4_size=$(cmr4_look_size "$_cmr4_look") || _cmr4_size=
  fi
  if [ -z "$_cmr4_size" ] && [ -n "$REA_CFG" ] &&
    [ -z "$(rea_get_key resolution "$REA_CFG")" ]; then
    _cmr4_look=$(rea_get_value look "$REA_CFG")
    [ -n "$_cmr4_look" ] && { _cmr4_size=$(cmr4_look_size "$_cmr4_look") || _cmr4_size=; }
  fi
  [ -n "$_cmr4_size" ] || return 0
  REA_ONE_RUN="${REA_ONE_RUN:+$REA_ONE_RUN
}resolution=$_cmr4_size"
}

rea_init || exit 1
# Tests load the configuration without running anything (REA_FUNCTIONS_ONLY=1).
[ "$_fonly" = 1 ] && return 0
rea_main "$@"
