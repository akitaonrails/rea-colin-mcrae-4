# Sourced by the cmr4-play tests: a scratch HOME, the player's CMR4_*
# environment, fakes for Wine and gamescope, and cmr4-play loaded through
# the shared play library (sdk/rea-play.sh) with its test seams on.
set -u
# Tests load cmr4-play with the SDK's convention: REA_FUNCTIONS_ONLY=1
# stops it before rea_main, REA_PLAY_HERE tells it where linux/ is ($0 is
# the test here).
TESTS=$(dirname "$(readlink -f "$0")")
T=$(mktemp -d)
trap 'rm -rf "$T"' EXIT
unset GAMESCOPE_WAYLAND_DISPLAY DRI_PRIME __NV_PRIME_RENDER_OFFLOAD __GLX_VENDOR_LIBRARY_NAME \
  WINEDLLOVERRIDES SDL_GAMECONTROLLER_ALLOW_BACKGROUND_EVENTS \
  SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS CMR4_WAIT 2>/dev/null
export T HOME=$T CMR4_PREFIX=$T/prefix CMR4_LAUNCHER=$T/CMR4Launcher.exe CMR4_RUN=$T/fake-run
CFGDIR=$CMR4_PREFIX/drive_c/users/me/AppData/Local/CMR4Launcher
mkdir -p "$CFGDIR"
: > "$T/CMR4Launcher.exe"
# Wine and gamescope are recorded, never run: gamescope is "installed"
# unless $T/no-gamescope exists, a settings run exits with $T/rc.
cat > "$T/fake-run" <<'FAKE'
#!/bin/sh
case "$*" in
  *"command -v gamescope"*) [ ! -e "$T/no-gamescope" ]; exit ;;
  *"wineserver"*) echo "$*" >> "$T/wineserver"; exit 0 ;;
  *"--settings"*) echo "$*" > "$T/settings"; exit "$(cat "$T/rc" 2>/dev/null || echo 0)" ;;
esac
echo "$*" > "$T/ran"
printf '<%s>\n' "$@" > "$T/args"
FAKE
chmod +x "$T/fake-run"
REA_FUNCTIONS_ONLY=1 REA_PLAY_HERE=$TESTS/.. . "$TESTS/../cmr4-play"
REA_TEST=1 REA_SYSFS=$T/nosys
fails=0
ok() { echo "ok   $1"; }
fail() { echo "FAIL $1"; fails=$((fails + 1)); }
contains() { # name haystack needle
  case "$2" in *"$3"*) ok "$1" ;; *) fail "$1: '$2' lacks '$3'" ;; esac
}
finish() {
  if [ "$fails" = 0 ]; then echo "all passed"; exit 0; fi
  echo "$fails failed"; exit 1
}
